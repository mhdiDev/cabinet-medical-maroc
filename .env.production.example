# À copier en .env sur le serveur (cp .env.production.example .env) puis remplir.
# Ne jamais commiter le .env.
# Générer les secrets avec `openssl rand -hex 32` (hexadécimal : sans caractère
# spécial, le mot de passe Postgres peut être inséré tel quel dans DATABASE_URL).

# PostgreSQL (DATABASE_URL est construite automatiquement dans docker-compose.yml)
POSTGRES_PASSWORD=change_me_strong_password

# JWT
JWT_SECRET=change_me_64_chars_minimum_secret_key_for_jwt_access_tokens_here
JWT_REFRESH_SECRET=change_me_64_chars_minimum_secret_key_for_jwt_refresh_tokens

# CORS — remplacer par l'IP publique OVH
CORS_ORIGIN=http://X.X.X.X

# MinIO
MINIO_ROOT_USER=cabinet_admin
MINIO_ROOT_PASSWORD=change_me_strong_minio_password

# URL publique des documents patients (servis par Nginx sous /files/)
MINIO_PUBLIC_URL=http://X.X.X.X/files

# Frontend — remplacer par l'IP publique OVH
NEXT_PUBLIC_API_URL=http://X.X.X.X/api
